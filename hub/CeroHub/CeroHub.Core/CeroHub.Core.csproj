<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    vJoy no tiene paquete NuGet nativo para .NET moderno. Referenciamos
    directamente el wrapper managed (vJoyInterfaceWrap.dll) del SDK oficial
    y copiamos la DLL nativa (vJoyInterface.dll) a la salida.
    Requiere el driver vJoy instalado en el sistema para funcionar.
  -->
  <ItemGroup>
    <Reference Include="vJoyInterfaceWrap">
      <HintPath>$(NuGetPackageRoot)vjoyinterface\0.2.1.6\runtimes\win-x64\lib\net20\vJoyInterfaceWrap.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)vjoyinterface\0.2.1.6\runtimes\win-x64\native\vJoyInterface.dll"
          Link="vJoyInterface.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
