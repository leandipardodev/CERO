<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    Interfaz vJoy (SDK oficial). Se referencian las DLLs del driver instalado
    en %ProgramFiles%\vJoy\x64 para garantizar compatibilidad con vjoy.sys.
    Requiere el driver vJoy instalado (github.com/BrunnerInnovation/vJoy, 2.2.2.0).
  -->
  <ItemGroup>
    <Reference Include="vJoyInterfaceWrap">
      <HintPath>C:\Program Files\vJoy\x64\vJoyInterfaceWrap.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="C:\Program Files\vJoy\x64\vJoyInterface.dll"
             Link="vJoyInterface.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>